<UserControl x:Class="RevitQAQC.WPF.Views.QAChecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="QA Checks"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17202A"/>

                <TextBlock Text="Run and review individual model quality checks"
                           FontSize="13"
                           Foreground="#7F8C8D"
                           Margin="0,5,0,25"/>
            </StackPanel>

            <!-- SUMMARY -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Available Checks"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#17202A"/>

                    <TextBlock Text="   7"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2563EB"/>

                </StackPanel>
            </Border>

            <!-- CHECK CARDS -->
            <UniformGrid Grid.Row="2"
                         Columns="2">

                <!-- 1 -->
                <Border Margin="0,0,15,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Missing Mark Parameter"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Checks elements that do not contain a valid Mark value."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2 -->
                <Border Margin="0,0,0,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Missing Comments"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Checks elements with missing Comments information."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3 -->
                <Border Margin="0,0,15,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Element Count"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Validates expected element counts in the model."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4 -->
                <Border Margin="0,0,0,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Duplicate Mark Values"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Detects duplicate Mark values across model elements."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5 -->
                <Border Margin="0,0,15,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Wrong Level Assignment"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Identifies elements assigned to incorrect levels."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6 -->
                <Border Margin="0,0,0,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Model Standards"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Checks model elements against defined project standards."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Implemented"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                        <Button Content="Run Check"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 7 -->
                <Border Margin="0,0,15,15"
                        Padding="20"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E8EE"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Naming Convention"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17202A"/>

                        <TextBlock Text="Validates element naming against configurable project rules."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D"
                                   Margin="0,8,0,15"/>

                        <TextBlock Text="Coming Next"
                                   Foreground="#D97706"
                                   FontWeight="SemiBold"/>

                        <Button Content="Configure"
                                Width="110"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                IsEnabled="False"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

        </Grid>
    </ScrollViewer>

</UserControl>