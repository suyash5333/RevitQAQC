<Window x:Class="RevitQAQC.WPF.Views.NamingIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Naming Convention Issues"
        Height="600"
        Width="1000"
        MinHeight="450"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#EEF1F6"
        FontFamily="Segoe UI">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Naming Convention Issues"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Elements that do not follow the configured naming standard"
                       FontSize="13"
                       Foreground="#8A93A3"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <!-- ISSUES TABLE -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E8EE"
                BorderThickness="1"
                Padding="12">

            <DataGrid x:Name="IssuesDataGrid"
                      MouseDoubleClick="IssuesDataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      ColumnHeaderHeight="40"
                      AlternatingRowBackground="#FAFBFD"
                      Background="White"
                      BorderThickness="0"
                      FontSize="13"
                      Foreground="#374151">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Element ID"
                                        Width="100"
                                        Binding="{Binding ElementId}"/>

                    <DataGridTextColumn Header="Category"
                                        Width="120"
                                        Binding="{Binding Category}"/>

                    <DataGridTextColumn Header="Current Value"
                                        Width="150"
                                        Binding="{Binding CurrentValue}"/>

                    <DataGridTextColumn Header="Problem"
                                        Width="*"
                                        Binding="{Binding Problem}"/>

                    <DataGridTextColumn Header="Suggested Value"
                                        Width="160"
                                        Binding="{Binding SuggestedValue}"/>

                    <DataGridTextColumn Header="Severity"
                                        Width="100"
                                        Binding="{Binding Severity}"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- CLOSE BUTTON -->
        <Button Grid.Row="2"
                Content="Close"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="CloseButton_Click"/>

    </Grid>

</Window>