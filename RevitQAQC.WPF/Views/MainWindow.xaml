<Window x:Class="RevitQAQC.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit QAQC"
        Height="800"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#17202A">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Row="0"
                            Margin="25,25,10,10">

                    <TextBlock Text="Revit QAQC"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <TextBlock Text="Model Quality Control"
                               Foreground="#AAB4C0"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1"
                            Margin="10,20,10,0">

                    <Button Content="🏠   Dashboard"
                        Height="50"
                        Margin="0,5"
                        Background="#263544"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        HorizontalContentAlignment="Left"
                        Padding="15"
                        Click="Dashboard_Click"/>   

                    <Button Content="🛡   QA Checks"
                            Click="QAChecks_Click"
                            Height="50"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#D5DCE3"
                            BorderThickness="0"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                    <Button Content="⚠   Issues"
                            Click="Issues_Click"
                            Height="50"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#D5DCE3"
                            BorderThickness="0"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                    <Button Content="🔧   Remediation"
                            Click="Remediation_Click"
                            Height="50"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#D5DCE3"
                            BorderThickness="0"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                    <Button Content="📄   Reports"
                            Click="Reports_Click"
                            Height="50"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#D5DCE3"
                            BorderThickness="0"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                    <Button Content="⚙   Settings"
                            Click="Settings_Click"
                            Height="50"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#D5DCE3"
                            BorderThickness="0"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2"
                           Text="Revit QAQC v1.0"
                           Foreground="#7F8C8D"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Grid Grid.Column="1"
              Background="#F4F6F9">

            <Frame x:Name="ContentFrame"
               NavigationUIVisibility="Hidden"
               Margin="20"/>

        </Grid>

    </Grid>
</Window>