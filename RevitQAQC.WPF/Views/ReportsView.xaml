<UserControl x:Class="RevitQAQC.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Reports"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#17202A"/>

            <TextBlock Text="Generate and export QA/QC model reports"
                       FontSize="13"
                       Foreground="#7F8C8D"
                       Margin="0,5,0,25"/>
        </StackPanel>

        <!-- REPORT OPTIONS -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- PDF -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,10,0"
                    BorderBrush="#E5E8EE"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="PDF Report"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#17202A"/>

                    <TextBlock Text="Generate a formatted QA/QC report containing model health, check results, issues and recommendations."
                               TextWrapping="Wrap"
                               Foreground="#7F8C8D"
                               Margin="0,10,0,20"/>

                    <Button Content="Export PDF"
                            Width="130"
                            Height="40"
                            HorizontalAlignment="Left"/>

                </StackPanel>

            </Border>

            <!-- JSON -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="10,0,0,0"
                    BorderBrush="#E5E8EE"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="JSON Report"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#17202A"/>

                    <TextBlock Text="Export structured QA/QC data for further processing, automation or integration."
                               TextWrapping="Wrap"
                               Foreground="#7F8C8D"
                               Margin="0,10,0,20"/>

                    <Button Content="Export JSON"
                            Width="130"
                            Height="40"
                            HorizontalAlignment="Left"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- REPORT CONTENT -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="25"
                BorderBrush="#E5E8EE"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Report Summary"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#17202A"/>

                <TextBlock Text="Run a QA/QC scan to generate report data."
                           Foreground="#7F8C8D"
                           Margin="0,8,0,25"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Model Health"
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total Checks"
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Total Issues"
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>