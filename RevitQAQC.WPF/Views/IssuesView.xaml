<UserControl x:Class="RevitQAQC.WPF.Views.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Issues"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#17202A"/>

            <TextBlock Text="Review model issues detected by QA checks"
                       FontSize="13"
                       Foreground="#7F8C8D"
                       Margin="0,5,0,25"/>

        </StackPanel>

        <!-- SUMMARY -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Total Issues"
                               Foreground="#7F8C8D"/>

                    <TextBlock x:Name="TotalIssuesText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#17202A"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- CRITICAL -->
            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Critical"
                               Foreground="#7F8C8D"/>

                    <TextBlock x:Name="CriticalText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- MAJOR -->
            <Border Grid.Column="2"
                    Margin="0,0,12,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Major"
                               Foreground="#7C3AED"/>

                    <TextBlock x:Name="MajorText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#D97706"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- WARNING -->
            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Warnings"
                               Foreground="#7F8C8D"/>

                    <TextBlock x:Name="WarningText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#CA8A04"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ISSUE TABLE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E5E8EE"
                BorderThickness="1">

            <DataGrid x:Name="IssuesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      ColumnHeaderHeight="40"
                      Background="White"
                      BorderThickness="0"
                      FontSize="13">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Check"
                                        Binding="{Binding Check}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Severity"
                                        Binding="{Binding Severity}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Element ID"
                                        Binding="{Binding ElementId}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Current Value"
                                        Binding="{Binding CurrentValue}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Problem"
                                        Binding="{Binding Problem}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Suggested Value"
                                        Binding="{Binding SuggestedValue}"
                                        Width="200"/>
                    <DataGridTemplateColumn Header="Select" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Select"
                    Click="SelectElement_Click"
                    Padding="8,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>